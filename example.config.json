{
  "listen": "127.0.0.1:8385",
  "audit": {
    "path": "audit.jsonl"
  },
  "upstreams": [
    {
      "name": "files",
      "url": "http://127.0.0.1:3001/mcp",
      "rate_limit": {
        "requests_per_second": 10,
        "burst": 20
      },
      "tools_deny": ["delete_file"],
      "resource_name": "Files MCP"
    },
    {
      "name": "search",
      "url": "http://127.0.0.1:3002/mcp",
      "header_timeout_seconds": 60
    }
  ]
}
